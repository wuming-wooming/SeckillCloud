          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();\r\nif (json.code === 200) {\r\n    pm.environment.set(\"accessToken\", json.data.accessToken);\r\n    pm.environment.set(\"refreshToken\", json.data.refreshToken);\r\n}"
            ]
          }
        }
      ],
