<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.sangoria</groupId>
        <artifactId>SeckillCloud</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>seckill-api</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- 只依赖 common，复用 R / ErrorCode；不依赖任何业务模块 -->
        <dependency>
            <groupId>org.sangoria</groupId>
            <artifactId>seckill-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- @HttpExchange / @PostExchange / @PathVariable / @RequestBody 所需 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- DTO 上的 @NotBlank / @Size / @Min / @Max -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>